# Copy this file to .env. Never commit the populated file.
HOST=127.0.0.1
PORT=5180
# Use an absolute persistent directory in production.
AVALEN_DATA_DIR=.avalen-data
# Set a long random owner setup token before first setup. If omitted, a temporary
# first-run token is printed in the service terminal. It is never sent to clients.
AVALEN_SETUP_TOKEN=
# Enable behind an HTTPS reverse proxy. Leave false for localhost development.
AVALEN_SECURE_COOKIE=false
AVALEN_MEDIA_RETENTION_DAYS=365
# Optional executable paths if ffprobe/ffmpeg are not on PATH.
# FFPROBE_PATH=/absolute/path/to/ffprobe
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# Optional, explicit-consent integrations. See ECOSYSTEM_SETUP.md for JSON contracts.
AVALEN_TRANSCRIPTION_URL=
AVALEN_TRANSCRIPTION_TOKEN=
AVALEN_AI_URL=
AVALEN_AI_TOKEN=
