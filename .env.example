# Copy this file to .env. Never commit the populated file.
HOST=127.0.0.1
PORT=5180
# Use an absolute persistent directory in production.
AVALEN_DATA_DIR=.avalen-data
# PostgreSQL. When set, records live there instead of a SQLite file in AVALEN_DATA_DIR
# (on Render: the database's internal URL). Requires AVALEN_SECRETS_KEY below.
# DATABASE_URL=postgres://user:password@host:5432/avalen
# Cloudflare R2 (or any S3-compatible private bucket) for photos, videos, voice notes
# and PDFs. When set, files live there instead of AVALEN_DATA_DIR/media. Use an access
# key limited to this one bucket. Endpoint: https://<account id>.r2.cloudflarestorage.com
# AVALEN_R2_BUCKET=
# AVALEN_R2_ENDPOINT=
# AVALEN_R2_ACCESS_KEY_ID=
# AVALEN_R2_SECRET_ACCESS_KEY=
# With both DATABASE_URL and R2 set, the server needs no persistent disk.
# Set a long random owner setup token before first setup. If omitted, a temporary
# first-run token is printed in the service terminal. It is never sent to clients.
AVALEN_SETUP_TOKEN=
# Enable behind an HTTPS reverse proxy. Leave false for localhost development.
AVALEN_SECURE_COOKIE=false
# Behind a hosting proxy (Fly.io, Render, a load balancer) every request comes from the
# proxy's address, so login limits would treat all users as one. Set true only when a
# proxy you control is always in front: the last X-Forwarded-For entry is then used.
AVALEN_TRUST_PROXY=false
# Or name a single-value header your host sets to the client address instead,
# e.g. fly-client-ip on Fly.io or cf-connecting-ip behind Cloudflare.
# AVALEN_CLIENT_IP_HEADER=
# Days of daily database snapshots kept in AVALEN_DATA_DIR/backups. 0 turns them off.
# They live on the same disk: also enable your host's volume snapshots.
AVALEN_BACKUP_DAYS=7
# Any coach can create an account and get a coach code. Set to off for a single-coach service.
AVALEN_COACH_SIGNUP=on
AVALEN_MEDIA_RETENTION_DAYS=365
# Optional executable paths if ffprobe/ffmpeg are not on PATH.
# FFPROBE_PATH=/absolute/path/to/ffprobe
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# Optional, explicit-consent integrations. See ECOSYSTEM_SETUP.md for JSON contracts.
AVALEN_TRANSCRIPTION_URL=
AVALEN_TRANSCRIPTION_TOKEN=
AVALEN_AI_URL=
AVALEN_AI_TOKEN=
# Public HTTPS address of this service, e.g. https://coach.example.com. Needed for
# online payments and wearable connections (OAuth returns and webhooks).
# AVALEN_PUBLIC_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Paymob and
# wearable tokens. Required with DATABASE_URL; otherwise a key file is generated in
# AVALEN_DATA_DIR. Keep a copy somewhere safe: without it those tokens can't be read.
# AVALEN_SECRETS_KEY=
# Wearables (optional). Leave blank to keep a connection unavailable.
# WHOOP: create an app at developer.whoop.com. Redirect URL:
#   <AVALEN_PUBLIC_URL>/api/wearables/whoop/callback  · Webhook URL (v2):
#   <AVALEN_PUBLIC_URL>/api/wearables/whoop/webhook
AVALEN_WHOOP_CLIENT_ID=
AVALEN_WHOOP_CLIENT_SECRET=
# Google Health (Fitbit Air, Pixel Watch, Fitbit): a Google Cloud web OAuth client
# with the Google Health API enabled. Redirect URI:
#   <AVALEN_PUBLIC_URL>/api/wearables/google/callback
AVALEN_GOOGLE_HEALTH_CLIENT_ID=
AVALEN_GOOGLE_HEALTH_CLIENT_SECRET=
